  m_Script: {fileID: 11500000, guid: a9a37bc9487d047e38458b25900c9841, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Hakaton.Tutorial::Hakaton.Tutorial.CaveTutorial
  caveScene: TutorialCave
  goblinViewer: {fileID: 1042966976}
  world: {fileID: 218823678}
  control: {fileID: 1042966974}
  view: {fileID: 5729559559069854571}
  fade: {fileID: 21109319}
  bubble: {fileID: 1971373931}
  zoneRadius: 3.5
  zoneHeight: 2.5
  sightBlockers:
    serializedVersion: 2
    m_Bits: 4294967019
  panicSeconds: 5
  panicRadius: 1.7
  panicSpeed: 3.2
  talkDistance: 2.8
  bushClearance: 1.5
  yelps:
  - {fileID: 8300000, guid: 0df31d7094c994183823469c10f63a36, type: 3}
  - {fileID: 8300000, guid: fe5e444c68ead4b6a94dd31ba7c28d6a, type: 3}
  panicScream: {fileID: 8300000, guid: e205f186d465c4df281bc731c0579eb0, type: 3}
  panicScreamVolume: 0.7
  goblinHitEffect: {fileID: 5627402125419773176, guid: 5567adfb3bd0fd14180e380e0bba7ead, type: 3}
  goblinHurt: {fileID: 11400000, guid: ef04ee52d152a4dd3934f14a138a5b6d, type: 2}
  goblinKnock: 2.6
  goblinFreezeSeconds: 0.9
  throwInstruction: {fileID: 11400000, guid: 375c1b8a4e6464d63b47ec832f1feaeb, type: 2}
  moveInstruction: {fileID: 11400000, guid: 09ee3d2b74efb42658bff760576608f0, type: 2}
  discardInstruction: {fileID: 11400000, guid: 82ae9d88f0ee64d30841a38536b7cc73, type: 2}
  fireId: fire
  iceId: ice
  strikeId: strike
  wheelHint: "\u041A\u043E\u043B\u0435\u0441\u043E \u043C\u044B\u0448\u0438 \u2014
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443"
  lines:
  - "\u042D\u0439! \u0422\u044B \u0447\u0435\u0433\u043E?! \u0422\u0443\u0442 \u0432\u043E\u043E\u0431\u0449\u0435-\u0442\u043E
    \u0437\u0430\u043D\u044F\u0442\u043E!"
  - "\u042F \u0442\u0443\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u043B. \u0421
    \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
  - "\u041F\u043E\u0433\u043E\u0434\u0438. \u042D\u0442\u043E \u0443 \u0442\u0435\u0431\u044F
    \u043A\u0430\u0440\u0442\u044B?"
  - "\u041A\u0430\u0440\u0442\u044B \u0435\u0441\u0442\u044C\u2026 \u041B\u0430\u0432\u043A\u0430
    \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C\u2026"
  - "\u041E! \u0411\u0443\u0434\u0435\u043C \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0430\u043C\u0438.
    \u042F \u0443\u0436\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D."
  - "\u0422\u044B \u0434\u043E\u0431\u044B\u0432\u0430\u0435\u0448\u044C \u0442\u043E\u0432\u0430\u0440,
    \u044F \u0434\u0430\u044E \u043B\u0430\u0432\u043A\u0443. \u0418 \u0446\u0435\u043D\u043D\u044B\u0435
    \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F."
  - "\u041F\u043E\u0439\u0434\u0451\u043C. \u041F\u043E\u043A\u0430\u0436\u0443,
    \u043A\u0443\u0434\u0430 \u0432\u0441\u0451 \u0442\u0430\u0449\u0438\u0442\u044C."
  thinkBefore: 3
  ideaLine: 4
  thinkSeconds: 1.6
  darkSeconds: 0.7
