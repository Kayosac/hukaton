--- !u!114 &143704713
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 143704712}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d48cc203903854e80b251cb5ca8e3995, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Hakaton.Tutorial::Hakaton.Tutorial.ShopTutorial
  trade: {fileID: 997696182}
  control: {fileID: 1042966974}
  goblin: {fileID: 2051388804}
  bubble: {fileID: 1971373931}
  capId: hare_foot
  fangId: boar_tusk
  arrival:
  - "\u0412\u043E\u0442 \u043C\u043E\u044F \u043B\u0430\u0432\u043A\u0430. \u041F\u043E\u043A\u0430
    \u043D\u0430\u0447\u043D\u0451\u043C \u0441\u043E \u0441\u0442\u0430\u0440\u044B\u0445
    \u0437\u0430\u043F\u0430\u0441\u043E\u0432."
  - "\u0428\u043B\u044F\u043F\u043A\u0430 \u0438 \u043A\u043B\u044B\u043A. \u041F\u043E\u0441\u0442\u0430\u0432\u044C
    \u0438\u0445 \u043D\u0430 \u0432\u0438\u0442\u0440\u0438\u043D\u0443 \u2014 \u043F\u0443\u0441\u0442\u044C
    \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0438 \u0432\u0438\u0434\u044F\u0442
    \u0442\u043E\u0432\u0430\u0440."
  stockedLine: "\u0422\u0435\u043F\u0435\u0440\u044C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0441\u044C
    \u0437\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439
    \u043B\u0430\u0432\u043A\u0443."
  bothFirst: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u044B\u0441\u0442\u0430\u0432\u044C
    \u043E\u0431\u0430 \u0442\u043E\u0432\u0430\u0440\u0430."
  capLesson: "\u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u0446\u0435\u043D\u0443.
    \u0427\u0438\u0441\u043B\u043E \u0443 \u0442\u043E\u0432\u0430\u0440\u0430 \u2014
    \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440. \u041C\u043E\u0436\u0435\u0448\u044C
    \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0435\u0433\u043E \u0438\u043B\u0438
    \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435."
  fangLesson: "\u042D\u0442\u043E\u0442 \u0443\u0436\u0435 \u043D\u0430\u0437\u0432\u0430\u043B
    \u0441\u0432\u043E\u044E \u0446\u0435\u043D\u0443. \u0425\u043E\u0447\u0435\u0448\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435 \u2014 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438
    \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u0443\u044E. \u041D\u043E \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435
    \u0443 \u043D\u0435\u0433\u043E \u043D\u0435 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0435."
  cheapLine: "\u041C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435. \u041D\u043E \u043C\u043E\u043D\u0435\u0442\u044B
    \u0443\u0436\u0435 \u0443 \u0442\u0435\u0431\u044F."
  walkedLine: "\u0423\u0448\u0451\u043B? \u0422\u043E\u0432\u0430\u0440-\u0442\u043E
    \u043E\u0441\u0442\u0430\u043B\u0441\u044F. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439!"
  refusedLine: "\u041D\u0435 \u0445\u043E\u0447\u0435\u0448\u044C \u2014 \u043D\u0435
    \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0439. \u041D\u0430\u0439\u0434\u0451\u043C
    \u0434\u0440\u0443\u0433\u043E\u0433\u043E."
  finale:
  - "\u0412\u043E\u0442 \u0438 \u043F\u0435\u0440\u0432\u044B\u0435 \u0434\u0435\u043D\u044C\u0433\u0438.
    \u0422\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0435\u0442 \u043A\u0443\u0434\u0430
    \u043D\u0435\u0441\u0442\u0438 \u0441\u0432\u043E\u0438 \u043D\u0430\u0445\u043E\u0434\u043A\u0438."
  - "\u041F\u0435\u0440\u0435\u0434 \u0443\u0445\u043E\u0434\u043E\u043C \u0437\u0430\u0433\u043B\u044F\u043D\u0438
    \u0437\u0430 \u0437\u0430\u043D\u0430\u0432\u0435\u0441\u043A\u0443. \u0422\u0430\u043C
    \u0435\u0449\u0451 \u043A\u043E\u0435-\u0447\u0442\u043E \u0435\u0441\u0442\u044C."
  - "\u0410 \u0443 \u043C\u0435\u043D\u044F \u0434\u0435\u043B\u0430 \u043F\u043E\u0432\u0430\u0436\u043D\u0435\u0435."
