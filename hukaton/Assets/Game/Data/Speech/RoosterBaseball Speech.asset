  m_Script: {fileID: 11500000, guid: 929800cbccd9044ad86b8101fbc57094, type: 3}
  m_Name: RoosterBaseball Speech
  m_EditorClassIdentifier: Hakaton.Expedition::Hakaton.Expeditions.CreatureSpeechProfile
  greetings:
  - "\u041A\u043E-\u043A\u043E! \u041F\u0440\u0438\u0432\u0435\u0442 \u0441 \u043F\u043E\u043B\u044F!"
  - "\u041E, \u0437\u0440\u0438\u0442\u0435\u043B\u044C! \u041F\u0440\u0438\u0432\u0435\u0442!"
  - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C
    \u0441\u043F\u043E\u0440\u0442\u0430!"
  - "\u041A\u043E\u043A\u043E \u043D\u0430 \u0441\u0432\u044F\u0437\u0438! \u0417\u0434\u043E\u0440\u043E\u0432\u043E!"
  - "\u041F\u0440\u0438\u0432\u0435\u0442! \u041F\u0435\u0440\u0435\u0440\u044B\u0432
    \u043D\u0430 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E."
  - "\u041E, \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F! \u0421\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u0439
    \u043F\u0440\u0438\u0432\u0435\u0442!"
  neutral:
  - "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u0441\u0442\u0430\u0434\u0438\u043E\u043D
    \u0437\u0430\u043A\u0440\u0438\u0447\u0438\u0442: \xAB\u041A\u043E-\u043A\u043E!\xBB"
  - "\u0422\u0440\u0435\u043D\u0438\u0440\u0443\u044E\u0441\u044C \u0434\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u0445\u043E\u0443\u043C-\u0440\u0430\u043D\u0430."
  - "\u041A\u0443\u0440\u044F\u0442\u043D\u0438\u043A \u2014 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E."
  - "\u0422\u044B \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u043D\u0435 \u0431\u0435\u0439\u0441\u0431\u043E\u043B\u044C\u043D\u044B\u0439
    \u0441\u043A\u0430\u0443\u0442?"
  - "\u0410\u0432\u0442\u043E\u0433\u0440\u0430\u0444? \u041F\u043E\u043A\u0430 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E."
  - "\u041C\u043E\u044F \u0431\u0438\u0442\u0430 \u0435\u0449\u0451 \u0432\u043E\u0439\u0434\u0451\u0442
    \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u044E."
  - "\u0417\u0435\u0440\u043D\u043E \u2014 \u043F\u043E\u0442\u043E\u043C. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
    \u0440\u0430\u0437\u043C\u0438\u043D\u043A\u0430."
  - "\u0412 \u0432\u044B\u0441\u0448\u0435\u0439 \u043B\u0438\u0433\u0435 \u043D\u0430\u0441\u0435\u0441\u0442\u044B
    \u043D\u0430\u0439\u0434\u0443\u0442\u0441\u044F?"
  fear:
  - "\u0422\u0430\u0439\u043C-\u0430\u0443\u0442! \u0422\u0430\u0439\u043C-\u0430\u0443\u0442!"
  - "\u041D\u0435 \u043F\u043E \u043A\u0440\u044B\u043B\u0443! \u0423 \u043C\u0435\u043D\u044F
    \u0441\u0435\u0437\u043E\u043D!"
  - "\u042D\u0442\u043E \u043D\u0435 \u043F\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C!"
  - "\u041C\u0430\u043C\u0430, \u0437\u0430\u0431\u0435\u0440\u0438 \u043C\u0435\u043D\u044F
    \u0441 \u043F\u043E\u043B\u044F!"
  - "\u042F \u0435\u0449\u0451 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u043D\u0435
    \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B!"
  - "\u0421\u0443\u0434\u044C\u044E! \u0413\u0434\u0435 \u0442\u0443\u0442 \u0441\u0443\u0434\u044C\u044F?!"
  aggression:
  - "\u0421\u043A\u0430\u043C\u0435\u0439\u043A\u0430 \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0445
    \u0442\u0435\u0431\u0435 \u0442\u0430\u043C."
  - "\u0422\u044B \u0432\u044B\u0437\u0432\u0430\u043B \u0431\u0443\u0434\u0443\u0449\u0443\u044E
    \u043B\u0435\u0433\u0435\u043D\u0434\u0443!"
  - "\u0421\u0435\u0439\u0447\u0430\u0441 \u0432\u044B\u043B\u0435\u0442\u0438\u0448\u044C
    \u0441 \u043F\u043E\u043B\u044F."
  - "\u041C\u043E\u044E \u043C\u0435\u0447\u0442\u0443 \u043A\u043B\u044E\u0432\u043E\u043C
    \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439."
  - "\u0420\u0430\u0437\u043C\u0438\u043D\u043A\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C."
  - "\u0414\u043E\u0438\u0433\u0440\u0430\u043B\u0441\u044F. \u0422\u0435\u043F\u0435\u0440\u044C
    \u043C\u043E\u044F \u043F\u043E\u0434\u0430\u0447\u0430."
  attack:
  - "\u041B\u043E\u0432\u0438 \u043F\u043E\u0434\u0430\u0447\u0443!"
  - "\u0425\u043E\u0443\u043C-\u0440\u0430\u043D!"
  - "\u041A\u043E-\u043A\u043E-\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u044B\u0439!"
  - "\u041F\u0440\u044F\u043C\u043E \u0432 \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0443!
    \u0413\u0434\u0435 \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0430?"
  - "\u042D\u0442\u043E\u0442 \u043C\u044F\u0447 \u2014 \u0437\u0430 \u0432\u044B\u0441\u0448\u0443\u044E
    \u043B\u0438\u0433\u0443!"
  - "\u0422\u0440\u0438 \u0441\u0442\u0440\u0430\u0439\u043A\u0430 \u2014 \u0438
    \u0442\u044B \u0432\u043E\u043D!"
