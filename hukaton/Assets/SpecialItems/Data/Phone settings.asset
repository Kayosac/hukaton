  callLines:
  - "\u0410\u043B\u043B\u043E, \u043F\u0430\u0440\u0442\u043D\u0451\u0440? \u041F\u0440\u043E\u0441\u0442\u043E
    \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E, \u0436\u0438\u0432\u043E\u0439
    \u043B\u0438. \u0416\u0438\u0432\u043E\u0439. \u041B\u0430\u0434\u043D\u043E."
  - "\u0415\u0441\u043B\u0438 \u0443\u0432\u0438\u0434\u0438\u0448\u044C \u0441\u0443\u043D\u0434\u0443\u043A,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u044B\u0448\u0438\u0442, \u2014
    \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439. \u0418\u043B\u0438
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439. \u041C\u043D\u0435-\u0442\u043E
    \u0447\u0442\u043E."
  - "\u0413\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u0432\u043E\u0434\u0443 \u043B\u0443\u0447\u0448\u0435
    \u0437\u0430\u043C\u043E\u0440\u043E\u0437\u0438\u0442\u044C. \u042D\u0442\u043E
    \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0439 \u0441\u043E\u0432\u0435\u0442.
    \u041F\u0435\u0440\u0432\u044B\u0439 \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439."
  - "\u0422\u044B \u043E\u043F\u044F\u0442\u044C \u043A\u0440\u0443\u0442\u0438\u0448\u044C
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442? \u042F \u0442\u043E\u0436\u0435.
    \u041C\u044B \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u043E\u0445\u043E\u0436\u0438."
  - "\u041A\u0430\u0440\u0442\u044B \u0431\u0440\u043E\u0441\u0430\u0439, \u0430
    \u043D\u0435 \u0434\u0435\u0440\u0436\u0438. \u041E\u043D\u0438 \u043E\u0442
    \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0434\u043E\u0440\u043E\u0436\u0430\u044E\u0442."
  - "\u0421\u043B\u044B\u0448\u0430\u043B, \u0432 \u043B\u0435\u0441\u0443 \u043A\u0442\u043E-\u0442\u043E
    \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442.
    \u042D\u0442\u043E \u0431\u044B\u043B \u043D\u0435 \u044F."
  - "\u0417\u0432\u043E\u043D\u044E \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E
    \u0437\u0432\u043E\u043D\u043E\u043A \u043F\u043B\u0430\u0442\u043D\u044B\u0439.
    \u0428\u0443\u0447\u0443. \u0418\u043B\u0438 \u043D\u0435\u0442."
