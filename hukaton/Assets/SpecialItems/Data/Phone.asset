  m_Name: Phone
  m_EditorClassIdentifier: Hakaton.SpecialItems::Hakaton.SpecialItems.SpecialItemDefinition
  id: phone
  displayName: "\u0422\u0435\u043B\u0435\u0444\u043E\u043D"
  price: 5000
  unlock: 1
  use: 0
  leftOfCards: 1
  tableSprite: {fileID: 21300000, guid: 789d2ce5c15b74980a2d23ca0d364faa, type: 3}
  menuIcon: {fileID: 21300000, guid: 789d2ce5c15b74980a2d23ca0d364faa, type: 3}
  introduction:
  - "\u041E, \u043F\u0430\u0440\u0442\u043D\u0451\u0440, \u0433\u043B\u044F\u043D\u044C,
    \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C.
    \u0422\u0435\u043B\u0435\u0444\u043E\u043D. \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439."
  - "\u0422\u0430\u043C \u0432\u043D\u0443\u0442\u0440\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442.
    \u041A\u0440\u0443\u0442\u0438\u0448\u044C, \u043F\u043E\u043A\u0430 \u0431\u0440\u043E\u0434\u0438\u0448\u044C
    \u043F\u043E \u043B\u0435\u0441\u0443. \u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u043B\u0430\u0442\u0438\u0442."
  - "\u0418\u043D\u043E\u0433\u0434\u0430 \u043D\u0435\u0442. \u0411\u0438\u0437\u043D\u0435\u0441
    \u0435\u0441\u0442\u044C \u0431\u0438\u0437\u043D\u0435\u0441."
  boughtLine: "\u041D\u043E\u0441\u0438 \u0441 \u0441\u043E\u0431\u043E\u0439. \u0421\u0434\u0430\u0447\u0438
    \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
