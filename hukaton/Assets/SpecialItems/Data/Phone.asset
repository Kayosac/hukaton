  m_Script: {fileID: 11500000, guid: 89b554bd77a25415384151c2feb157fd, type: 3}
  m_Name: Phone
  m_EditorClassIdentifier: Hakaton.SpecialItems::Hakaton.SpecialItems.SpecialItemDefinition
  id: phone
  displayName: "\u0422\u0435\u043B\u0435\u0444\u043E\u043D"
  price: 1000
  unlock: 3
  use: 0
  leftOfCards: 1
  tableSprite: {fileID: 21300000, guid: 789d2ce5c15b74980a2d23ca0d364faa, type: 3}
  menuIcon: {fileID: 21300000, guid: 789d2ce5c15b74980a2d23ca0d364faa, type: 3}
  introduction:
  - "\u041E, \u043F\u0430\u0440\u0442\u043D\u0451\u0440, \u0433\u043B\u044F\u043D\u044C,
    \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C.
    \u0422\u0435\u043B\u0435\u0444\u043E\u043D. \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439."
  - "\u0422\u0430\u043C \u0432\u043D\u0443\u0442\u0440\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442.
    \u041A\u0440\u0443\u0442\u0438\u0448\u044C, \u043F\u043E\u043A\u0430 \u0431\u0440\u043E\u0434\u0438\u0448\u044C
    \u043F\u043E \u043B\u0435\u0441\u0443. \u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u043B\u0430\u0442\u0438\u0442."
  - "\u0418\u043D\u043E\u0433\u0434\u0430 \u043D\u0435\u0442. \u0411\u0438\u0437\u043D\u0435\u0441
    \u0435\u0441\u0442\u044C \u0431\u0438\u0437\u043D\u0435\u0441."
  boughtLine: "\u041D\u043E\u0441\u0438 \u0441 \u0441\u043E\u0431\u043E\u0439. \u0421\u0434\u0430\u0447\u0438
    \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
  howToUse:
  - "\u0421\u043B\u0443\u0448\u0430\u0439, \u043A\u0430\u043A \u0441 \u043D\u0438\u043C.
    \u041D\u0430 \u0432\u044B\u043B\u0430\u0437\u043A\u0435 \u0434\u043E\u0441\u0442\u0430\u0451\u0448\u044C
    \u2014 Q. \u0417\u0430\u0436\u043C\u0451\u0448\u044C Q \u2014 \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C,
    \u0447\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u044C."
  - "Tab \u2014 \u0434\u0451\u0440\u043D\u0443\u043B \u0440\u0443\u0447\u043A\u0443,
    Tab \u0435\u0449\u0451 \u0440\u0430\u0437 \u2014 \u0441\u0442\u043E\u043F. \u041A\u0430\u0436\u0434\u044B\u0439
    \u0441\u043F\u0438\u043D \u2014 \u0434\u0435\u0441\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442
    \u0438 \u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0431\u0430\u0442\u0430\u0440\u0435\u0438."
  - "\u0422\u0440\u0438 \u043C\u043E\u043D\u0435\u0442\u044B \u2014 \u043F\u043B\u0430\u0442\u0438\u0442.
    \u0422\u0440\u0438 \u043A\u0430\u0440\u0442\u044B \u2014 \u043A\u0430\u0440\u0442\u0430
    \u0432 \u0440\u0443\u043A\u0443, \u043D\u0430 \u043E\u0434\u0438\u043D \u0431\u0440\u043E\u0441\u043E\u043A.
    \u0421\u0435\u0440\u0434\u0446\u0430 \u043B\u0435\u0447\u0430\u0442, \u043C\u043E\u043B\u043D\u0438\u0438
    \u0433\u043E\u043D\u044F\u0442."
  - "\u0422\u0440\u0438 \u0447\u0435\u0440\u0435\u043F\u0430 \u2014 \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442
    \u0441\u0435\u0440\u0434\u0446\u0430. \u0410 \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C
    \u0441\u0435\u0440\u0434\u0446\u0435 \u2014 \u0432\u0441\u0451, \u043F\u0438\u0448\u0438
    \u043F\u0440\u043E\u043F\u0430\u043B\u043E."
  - "\u0422\u0440\u0438 \u0433\u043E\u0431\u043B\u0438\u043D\u0430 \u2014 \u044D\u0442\u043E
    \u044F \u0437\u0432\u043E\u043D\u044E. \u0411\u0430\u0442\u0430\u0440\u0435\u044E
    \u043F\u043E\u0434\u043A\u0430\u0447\u0430\u0435\u0448\u044C \u043D\u0430 \u043A\u043E\u043C\u043F\u0435.
    \u0412\u0441\u0451, \u0438\u0434\u0438 \u043A\u0440\u0443\u0442\u0438."
