  introduction:
  - "\u0410 \u044D\u0442\u043E, \u043F\u0430\u0440\u0442\u043D\u0451\u0440, \u043A\u0430\u0441\u0441\u0435\u0442\u043D\u0438\u043A.
    \u0421 \u043D\u0430\u0443\u0448\u043D\u0438\u043A\u0430\u043C\u0438."
  - "\u041A\u0430\u0441\u0441\u0435\u0442\u044B \u0432\u043D\u0443\u0442\u0440\u0438.
    \u0427\u044C\u0438 \u2014 \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439.
    \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0438."
  - "\u0428\u0430\u0433\u0430\u0442\u044C \u043F\u043E \u043B\u0435\u0441\u0443 \u043F\u043E\u0434
    \u043C\u0443\u0437\u044B\u043A\u0443 \u2014 \u0441\u043E\u0432\u0441\u0435\u043C
    \u0434\u0440\u0443\u0433\u043E\u0435 \u0434\u0435\u043B\u043E. \u041C\u0435\u0440\u0442\u0432\u044F\u043A\u0438
    \u0442\u043E\u0436\u0435 \u0442\u0430\u043A \u0434\u0443\u043C\u0430\u044E\u0442."
  boughtLine: "\u041D\u0430\u0443\u0448\u043D\u0438\u043A\u0438 \u043F\u043E\u0447\u0442\u0438
    \u0447\u0438\u0441\u0442\u044B\u0435. \u041F\u043E\u0447\u0442\u0438."
