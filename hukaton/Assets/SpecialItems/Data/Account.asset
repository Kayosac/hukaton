  m_Script: {fileID: 11500000, guid: 89b554bd77a25415384151c2feb157fd, type: 3}
  m_Name: Account
  m_EditorClassIdentifier: Hakaton.SpecialItems::Hakaton.SpecialItems.SpecialItemDefinition
  id: hapay_account
  displayName: "\u0410\u043a\u043a\u0430\u0443\u043d\u0442 \u043d\u0430 \u0445\u0430PAY"
  price: 1500
  unlock: 4
  use: 2
  tableSprite: {fileID: 21300000, guid: 63099e87971a4503a991109a254bb311, type: 3}
  menuIcon: {fileID: 21300000, guid: 63099e87971a4503a991109a254bb311, type: 3}
  introduction:
  - "\u0413\u043b\u044f\u043d\u044c, \u043f\u0430\u0440\u0442\u043d\u0451\u0440. \u0411\u0443\u043c\u0430\u0436\u043a\u0430 \u043f\u0440\u0435\u0436\u043d\u0435\u0433\u043e \u0445\u043e\u0437\u044f\u0438\u043d\u0430. \u041b\u043e\u0433\u0438\u043d, \u043f\u0430\u0440\u043e\u043b\u044c."
  - "\u0410\u043a\u043a\u0430\u0443\u043d\u0442 \u043d\u0430 \u0445\u0430PAY. \u0422\u0430\u043c \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u0435\u0440\u044b. \u0421\u0442\u0440\u0430\u043d\u043d\u044b\u0435. \u041f\u043b\u0430\u0442\u044f\u0442 \u0445\u043e\u0440\u043e\u0448\u043e."
  - "\u042f \u0431\u044b \u0441\u0430\u043c, \u0434\u0430 \u043b\u0430\u043f\u044b \u0434\u043b\u044f \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u044b \u043d\u0435 \u0442\u0435."
  boughtLine: "\u0411\u0443\u043c\u0430\u0436\u043a\u0443 \u043d\u0435 \u0442\u0435\u0440\u044f\u0439. \u0412\u0442\u043e\u0440\u043e\u0439 \u043d\u0435\u0442."
  howToUse:
  - "\u041a\u043e\u043c\u043f \u0432 \u043f\u043e\u0434\u0441\u043e\u0431\u043a\u0435. \u0412\u043a\u043b\u044e\u0447\u0438\u0448\u044c \u2014 \u0413\u0432\u043e\u0437\u0434\u0438\u043a \u0432\u0441\u0451 \u043f\u043e\u043a\u0430\u0436\u0435\u0442."
  - "\u041e\u043d \u0443 \u043c\u0435\u043d\u044f \u0443\u043c\u043d\u044b\u0439. \u0414\u043b\u044f \u0433\u0432\u043e\u0437\u0434\u044f."
