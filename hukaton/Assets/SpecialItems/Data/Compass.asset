--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 89b554bd77a25415384151c2feb157fd, type: 3}
  m_Name: Compass
  m_EditorClassIdentifier: Hakaton.SpecialItems::Hakaton.SpecialItems.SpecialItemDefinition
  id: ant_compass
  displayName: "\u041A\u043E\u043C\u043F\u0430\u0441-\u043C\u0443\u0440\u0430\u0432\u0435\u0439"
  price: 800
  unlock: 5
  use: 0
  tableSprite: {fileID: 21300000, guid: 6499b586444af451598fcc1514ae2c81, type: 3}
  menuIcon: {fileID: 21300000, guid: 6499b586444af451598fcc1514ae2c81, type: 3}
  introduction:
  - "\u0421\u043B\u044B\u0448\u0430\u043B, \u0442\u044B \u041C\u0430\u0442\u043A\u0443
    \u0437\u0430\u0432\u0430\u043B\u0438\u043B. \u0423\u0432\u0430\u0436\u0430\u044E.
    \u0410 \u0443 \u043C\u0435\u043D\u044F \u0442\u0443\u0442 \u043A\u043E\u0435-\u0447\u0442\u043E
    \u0441 \u0435\u0451 \u0441\u0442\u043E\u043B\u0430."
  - "\u041A\u043E\u043C\u043F\u0430\u0441. \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043C\u0435\u0441\u0442\u043E
    \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u2014 \u043C\u0443\u0440\u0430\u0432\u0435\u0439.
    \u0416\u0438\u0432\u043E\u0439. \u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439
    \u0435\u0433\u043E \u043F\u0430\u043B\u044C\u0446\u0435\u043C."
  - "\u041E\u043D \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u044F\u043D\u0435\u0442\u0441\u044F
    \u043A \u0441\u0432\u043E\u0438\u043C: \u043D\u0430\u0432\u0435\u0440\u0445\u0443
    \u2014 \u043A \u043C\u0443\u0440\u0430\u0432\u0435\u0439\u043D\u0438\u043A\u0443,
    \u0432\u043D\u0438\u0437\u0443 \u2014 \u043A \u0438\u0445 \u0437\u0430\u043D\u0430\u0447\u043A\u0430\u043C."
  boughtLine: "\u041A\u043E\u0440\u043C\u0438 \u0435\u0433\u043E\u2026 \u0445\u043E\u0442\u044F
    \u043D\u0435\u0442, \u043D\u0435 \u043A\u043E\u0440\u043C\u0438. \u041E\u043D
    \u0441\u0430\u043C \u043D\u0430\u0439\u0434\u0451\u0442."
  howToUse:
  - "\u041D\u0430 \u0432\u044B\u043B\u0430\u0437\u043A\u0435 \u0434\u043E\u0441\u0442\u0430\u0451\u0448\u044C
    \u2014 Q. \u0417\u0430\u0436\u043C\u0451\u0448\u044C Q \u2014 \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C,
    \u0447\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u044C."
  - "\u041D\u0430\u0432\u0435\u0440\u0445\u0443 \u043C\u0443\u0440\u0430\u0432\u0435\u0439
    \u0442\u044F\u043D\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043A
    \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443 \u043C\u0443\u0440\u0430\u0432\u0435\u0439\u043D\u0438\u043A\u0443."
  - "\u0412\u043D\u0438\u0437\u0443 \u2014 \u043A \u0442\u0430\u0439\u043D\u0438\u043A\u0443,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0435\u0449\u0451 \u043D\u0435 \u0432\u0441\u043A\u0440\u044B\u0442.
    \u0412\u0441\u043A\u0440\u044B\u043B \u0432\u0441\u0435 \u2014 \u043F\u043E\u0442\u044F\u043D\u0435\u0442
    \u043A \u0432\u044B\u0445\u043E\u0434\u0443."
  - "\u041D\u0435 \u0447\u0443\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u2014
    \u0431\u0435\u0433\u0430\u0435\u0442 \u043F\u043E \u043A\u0440\u0443\u0433\u0443.
    \u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u0443\u0442 \u043F\u0443\u0441\u0442\u043E."
