  startLines:
  - "\u041F\u043E\u0445\u043E\u0436\u0435, \u0432\u044B \u043F\u044B\u0442\u0430\u0435\u0442\u0435\u0441\u044C
    \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u043E\u043A\u043D\u043E! \u0425\u043E\u0442\u0438\u0442\u0435
    \u043F\u043E\u043C\u043E\u0449\u044C?"
  - "\u041E\u0439. \u041F\u043E\u0445\u043E\u0436\u0435, \u0432\u044B \u0441\u043A\u0430\u0447\u0430\u043B\u0438
    \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u043E. \u0425\u043E\u0442\u0438\u0442\u0435,
    \u044F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u044E \u0432\u0430\u043C \u0440\u0435\u043A\u043B\u0430\u043C\u0443
    \u0432\u0441\u043B\u0443\u0445?"
  midLines:
  - "\u0421\u043E\u0432\u0435\u0442 \u0434\u043D\u044F: \u043E\u043A\u043D\u0430
    \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043A\u0440\u0435\u0441\u0442\u0438\u043A\u043E\u043C.
    \u041E\u0431\u044B\u0447\u043D\u043E."
  - "\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0442\u0435\u0441\u044C, \u044D\u0442\u043E
    \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u0432\u0441\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    \u0432\u0435\u043A\u0430 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E!"
  fakeLines:
  - "\u042D\u0442\u043E \u0431\u044B\u043B \u043D\u0435 \u0442\u043E\u0442 \u043A\u0440\u0435\u0441\u0442\u0438\u043A.
    \u0422\u043E\u0442 \u043A\u0440\u0435\u0441\u0442\u0438\u043A \u2014 \u0434\u043B\u044F
    \u043A\u0440\u0430\u0441\u043E\u0442\u044B."
  - "\u0425\u0430! \u0414\u0432\u043E\u0439\u043D\u043E\u0439 \u043A\u0440\u0435\u0441\u0442\u0438\u043A!
    \u041A\u043B\u0430\u0441\u0441\u0438\u043A\u0430 \u0413\u043E\u0431\u043B\u0438\u043D\u0441\u043E\u0444\u0442."
  winLines:
  - "\u0412\u044B \u0437\u0430\u043A\u0440\u044B\u043B\u0438 {closed|\u043E\u043A\u043D\u043E|\u043E\u043A\u043D\u0430|\u043E\u043A\u043E\u043D}!
    \u0413\u043E\u0431\u043B\u0438\u043D\u0441\u043E\u0444\u0442 \u0434\u0430\u0440\u0438\u0442
    \u0432\u0430\u043C {reward|\u043C\u043E\u043D\u0435\u0442\u0443|\u043C\u043E\u043D\u0435\u0442\u044B|\u043C\u043E\u043D\u0435\u0442}
    \u0437\u0430 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435. \u0420\u0435\u043A\u043E\u0440\u0434:
    {record}."
  - "\u0420\u0435\u043A\u043B\u0430\u043C\u0430 \u043F\u043E\u0431\u0435\u0436\u0434\u0435\u043D\u0430!
    \u0414\u0435\u0440\u0436\u0438\u0442\u0435 {reward|\u043C\u043E\u043D\u0435\u0442\u0443|\u043C\u043E\u043D\u0435\u0442\u044B|\u043C\u043E\u043D\u0435\u0442}.
    \u0417\u0430\u043A\u0440\u044B\u0442\u043E \u043E\u043A\u043E\u043D: {closed},
    \u0440\u0435\u043A\u043E\u0440\u0434: {record}. \u042F \u043F\u043E\u0447\u0442\u0438
    \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u043B!"
  lostLines:
  - "\u041C\u044B \u0441\u043D\u043E\u0432\u0430 \u0441 \u0432\u0430\u043C\u0438!
    \u0412\u0438\u0440\u0443\u0441 \u0432\u0437\u044F\u043B \u0432\u0441\u0435\u0433\u043E
    {penalty|\u043C\u043E\u043D\u0435\u0442\u0443|\u043C\u043E\u043D\u0435\u0442\u044B|\u043C\u043E\u043D\u0435\u0442}.
    \u041F\u043E\u0447\u0442\u0438 \u0434\u0430\u0440\u043E\u043C!"
  - "\u041F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u043F\u0440\u043E\u0448\u043B\u0430
    \u0443\u0441\u043F\u0435\u0448\u043D\u043E. \u041C\u043E\u043D\u0435\u0442\u044B
    \u2014 \u043D\u0435\u0442: \u043C\u0438\u043D\u0443\u0441 {penalty}."
  escapeLines:
  - "\u0412\u044B \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u043B\u0438 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440,
    \u043D\u043E \u0440\u0435\u043A\u043B\u0430\u043C\u0430 \u043D\u0438\u043A\u0443\u0434\u0430
    \u043D\u0435 \u0434\u0435\u043B\u0430\u0441\u044C. \u041E\u043D\u0430 \u0436\u0434\u0430\u043B\u0430.
    \u041C\u0438\u043D\u0443\u0441 {penalty|\u043C\u043E\u043D\u0435\u0442\u0430|\u043C\u043E\u043D\u0435\u0442\u044B|\u043C\u043E\u043D\u0435\u0442}."
  - "\u0423\u0431\u0435\u0433\u0430\u0442\u044C \u043E\u0442 \u0440\u0435\u043A\u043B\u0430\u043C\u044B
