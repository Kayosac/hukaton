--- !u!114 &3401342203166403404
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7847917642306167904}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9a097604e2534556b166df4474f88e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Hakaton.Computer::Hakaton.Computer.PcGuide
  book: {fileID: 0}
  spotlight: {fileID: 3958695159505755779}
  pointer: {fileID: 6563693232749862368}
  computer: {fileID: 4407614084394492300}
  helper: {fileID: 2709279021147186973}
  help: {fileID: 8917348847950466370}
  demoLayer: {fileID: 5838441042656936340}
  desktopTour:
    id: pc.desktop
    steps:
    - key: hello
      text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
        \u041F\u043E\u0445\u043E\u0436\u0435, \u0432\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435
        \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0438 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440.
        \u042F \u0413\u0432\u043E\u0437\u0434\u0438\u043A, \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
        \xAB\u0413\u043E\u0431\u043B\u0438\u043D\u0441\u043E\u0444\u0442\xBB. \u041F\u043E\u043A\u0430\u0436\u0443,
        \u0447\u0442\u043E \u0442\u0443\u0442 \u0433\u0434\u0435."
      kind: 0
      padding: 4
    - key: icons
      text: "\u042D\u0442\u043E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B.
        \xAB\u041A\u0430\u0440\u0442\u044B\xBB \u2014 \u0432\u0430\u0448\u0430 \u043A\u043E\u043B\u043E\u0434\u0430.
        \xAB\u041F\u0440\u043E\u043A\u0430\u0447\u043A\u0430\xBB \u2014 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
        \u0437\u0430 \u043C\u043E\u043D\u0435\u0442\u044B. \xABtutorial\xBB \u2014
        \u0441\u043F\u0440\u0430\u0432\u043A\u0430 \u043E\u0431\u043E \u0432\u0441\u0451\u043C
        \u043D\u0430 \u0441\u0432\u0435\u0442\u0435."
      kind: 0
      padding: 3
    - key: storage-icon
      text: "\u0410 \xAB\u0421\u043A\u043B\u0430\u0434\xBB \u0441\u0447\u0438\u0442\u0430\u0435\u0442
        \u0442\u043E\u0432\u0430\u0440: \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435
        \u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u043E\u0438\u0442
        \u043D\u0430 \u0432\u0438\u0442\u0440\u0438\u043D\u0435. \u0417\u0430\u0433\u043B\u044F\u043D\u0438\u0442\u0435
        \u043F\u043E\u0441\u043B\u0435 \u0432\u044B\u043B\u0430\u0437\u043A\u0438."
      kind: 0
      padding: 3
    - key: start
      text: "\u0427\u0435\u0440\u0435\u0437 \xAB\u041F\u0443\u0441\u043A\xBB \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0442\u043E \u0436\u0435 \u0441\u0430\u043C\u043E\u0435. \u0422\u0430\u043C
        \u0436\u0435 \xAB\u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C\xBB.
        \u041D\u0435 \u043D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
        \u0442\u0430\u043A, \u043C\u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E."
      kind: 0
      padding: 2
    - key: tray
      text: "\u0421\u043F\u0440\u0430\u0432\u0430 \u0432\u0430\u0448\u0438 \u043C\u043E\u043D\u0435\u0442\u044B
        \u0438 \u0432\u0440\u0435\u043C\u044F. \u041C\u043E\u043D\u0435\u0442\u044B
        \u0442\u0435 \u0436\u0435, \u0447\u0442\u043E \u0432 \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0435:
        \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440 \u0447\u0435\u0441\u0442\u043D\u044B\u0439."
      kind: 0
      padding: 2
    - key: open-cards
      text: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \xAB\u041A\u0430\u0440\u0442\u044B\xBB:
        \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0437\u043D\u0430\u0447\u043E\u043A."
      kind: 1
      padding: 3
  cardsTour:
    id: pc.cards
    steps:
    - key: counts
      text: "\u041A\u043E\u043B\u043E\u0434\u0430 \u2014 \u043A\u0430\u0440\u0442\u044B,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u044B \u0431\u0435\u0440\u0451\u0442\u0435
        \u043D\u0430 \u0432\u044B\u043B\u0430\u0437\u043A\u0443. \u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F
        \u2014 \u0432\u0441\u0435 \u0432\u0430\u0448\u0438 \u043A\u0430\u0440\u0442\u044B.
        \u0412\u0442\u043E\u0440\u0430\u044F \u0446\u0438\u0444\u0440\u0430 \u2014
        \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u043B\u0435\u0437\u0435\u0442."
      kind: 0
      padding: 2
    - key: faded
      text: "\u042F\u0440\u043A\u0438\u0435 \u043A\u0430\u0440\u0442\u044B \u043B\u0435\u0436\u0430\u0442
        \u0432 \u043A\u043E\u043B\u043E\u0434\u0435. \u0411\u043B\u0435\u0434\u043D\u044B\u0435
        \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438,
        \u043D\u0430 \u0432\u044B\u043B\u0430\u0437\u043A\u0443 \u043D\u0435 \u043F\u043E\u0439\u0434\u0443\u0442."
      kind: 0
      padding: 2
    - key: toggle
      text: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043B\u044E\u0431\u0443\u044E
        \u043A\u0430\u0440\u0442\u0443: \u043E\u043D\u0430 \u0443\u0439\u0434\u0451\u0442
        \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u044B \u0438\u043B\u0438 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F
        \u0432 \u043D\u0435\u0451."
      kind: 1
      padding: 2
    - key: toggle-back
      text: "\u0412\u0438\u0434\u0438\u0442\u0435, \u043F\u043E\u043C\u0435\u043D\u044F\u043B\u0430\u0441\u044C.
        \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437,
        \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C
        \u043A\u0430\u043A \u0431\u044B\u043B\u043E."
      kind: 1
      padding: 2
    - key: merge
      text: "\u0414\u0432\u0435 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0435
        \u043A\u0430\u0440\u0442\u044B \u043E\u0434\u043D\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F
        \u043C\u043E\u0436\u043D\u043E \u0441\u043B\u0438\u0442\u044C \u0432 \u043E\u0434\u043D\u0443,
        \u043F\u043E\u0441\u0438\u043B\u044C\u043D\u0435\u0435: \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
        \u043E\u0434\u043D\u0443 \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E.
        \u042D\u0442\u043E \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430!"
      kind: 2
      padding: 6
    - key: hover
      text: "\u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430 \u043A\u0430\u0440\u0442\u0443
        \u0438 \u043F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435 \u2014 \u044F
        \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443, \u0447\u0442\u043E \u043E\u043D\u0430
        \u0443\u043C\u0435\u0435\u0442."
      kind: 1
      padding: 2
    - key: sort
      text: "\u042D\u0442\u0430 \u043A\u043D\u043E\u043F\u043A\u0430 \u043C\u0435\u043D\u044F\u0435\u0442
        \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u043A\u0430\u0440\u0442: \u043F\u043E
        \u0438\u043C\u0435\u043D\u0438, \u043F\u043E \u0443\u0440\u043E\u0432\u043D\u044E,
        \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043A\u043E\u043B\u043E\u0434\u0430
        \u0438 \u0442\u0430\u043A \u0434\u0430\u043B\u0435\u0435."
      kind: 0
      padding: 2
    - key: status
      text: "\u0412\u043D\u0438\u0437\u0443 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
        \u043F\u0438\u0448\u0435\u0442, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
        \u0418 \u0440\u0443\u0433\u0430\u0435\u0442\u0441\u044F \u043A\u0440\u0430\u0441\u043D\u044B\u043C,
        \u0435\u0441\u043B\u0438 \u0447\u0442\u043E \u043D\u0435 \u0442\u0430\u043A."
      kind: 0
      padding: 2
    - key: close
      text: "\u041E\u043A\u043D\u043E \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u043A\u0440\u0435\u0441\u0442\u0438\u043A\u043E\u043C, \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
        \u2014 Esc \u0438\u043B\u0438 \u043F\u0440\u0430\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439.
        \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u2014 \u0432 \xABtutorial\xBB.
        \u0423\u0434\u0430\u0447\u043D\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438!"
      kind: 0
      padding: 2
  upgradesTour:
    id: pc.upgrades
    steps:
    - key: rows
      text: "\u0417\u0434\u0435\u0441\u044C \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
        \u0437\u0430 \u043C\u043E\u043D\u0435\u0442\u044B: \u0440\u0443\u043A\u0430,
        \u043A\u043E\u043B\u043E\u0434\u0430, \u0432\u0440\u0435\u043C\u044F \u0441\u043C\u0435\u043D\u044B
        \u0438 \u043F\u0440\u043E\u0447\u0435\u0435. \u041D\u043E\u0432\u044B\u0435
        \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F \u0441\u0430\u043C\u0438."
      kind: 0
      padding: 2
    - key: bar
      text: "\u0428\u043A\u0430\u043B\u0430 \u2014 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0443\u0436\u0435 \u043A\u0443\u043F\u043B\u0435\u043D\u043E. \u0420\u044F\u0434\u043E\u043C
        \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E \u0441\u0442\u0430\u043D\u0435\u0442
        \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u043A\u0443\u043F\u043A\u0438."
      kind: 0
      padding: 2
    - key: price
      text: "\u0426\u0435\u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
        \u0448\u0430\u0433\u0430. \u041A\u0440\u0430\u0441\u043D\u0430\u044F \u2014
        \u043C\u043E\u043D\u0435\u0442 \u043F\u043E\u043A\u0430 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
      kind: 0
      padding: 2
    - key: buy
      text: "\u041A\u043D\u043E\u043F\u043A\u0430 \u0441 \u043F\u043B\u044E\u0441\u043E\u043C
        \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
        \u0448\u0430\u0433. \u0421\u0440\u0430\u0437\u0443, \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
        \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432."
      kind: 0
      padding: 2
  storageTour:
    id: pc.storage
    steps:
    - key: storage-window
      text: "\u042D\u0442\u043E \xAB\u0421\u043A\u043B\u0430\u0434\xBB. \u0412\u0441\u0451,
        \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438
        \u0441 \u0432\u044B\u043B\u0430\u0437\u043E\u043A \u0438 \u0435\u0449\u0451
        \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u043B\u0438, \u0447\u0438\u0441\u043B\u0438\u0442\u0441\u044F
        \u0437\u0434\u0435\u0441\u044C. \u042F \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B.
        \u0414\u0432\u0430\u0436\u0434\u044B."
      kind: 0
      padding: 2
    - key: storage-totals
      text: "\u0421\u0432\u0435\u0440\u0445\u0443 \u0438\u0442\u043E\u0433: \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0448\u0442\u0443\u043A \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435,
        \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0436\u0435 \u0441\u0442\u043E\u0438\u0442
        \u043D\u0430 \u0432\u0438\u0442\u0440\u0438\u043D\u0435 \u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0432\u0441\u0435\u0433\u043E \u0432\u0438\u0434\u043E\u0432."
      kind: 0
      padding: 2
    - key: storage-header
      text: "\u041E\u0434\u043D\u0430 \u0441\u0442\u0440\u043E\u043A\u0430 \u2014
        \u043E\u0434\u0438\u043D \u0432\u0438\u0434 \u0442\u043E\u0432\u0430\u0440\u0430.
        \u041A\u0440\u0443\u043F\u043D\u043E \u2014 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435, \u0440\u044F\u0434\u043E\u043C
        \u2014 \u043D\u0430 \u0432\u0438\u0442\u0440\u0438\u043D\u0435. \u0426\u0435\u043D\u0430
        \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C\u0430\u044F:
        \u043E\u0442 \u043D\u0435\u0451 \u0438 \u0442\u043E\u0440\u0433\u0443\u0439\u0442\u0435\u0441\u044C."
      kind: 0
      padding: 2
    - key: storage-list
      text: "\u0412\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u043D\u0430
        \u0432\u0438\u0442\u0440\u0438\u043D\u0443 \u2014 \u0432 \u043B\u0430\u0432\u043A\u0435,
        \u0440\u0443\u043A\u0430\u043C\u0438. \u041A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
        \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0447\u0438\u0442\u0430\u0435\u0442:
        \u0434\u0432\u0438\u0433\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440
        \u043E\u043D \u0431\u043E\u0438\u0442\u0441\u044F."
      kind: 0
      padding: 2
    - key: storage-empty
      text: "\u041F\u043E\u043A\u0430 \u043F\u0443\u0441\u0442\u043E. \u0421\u0445\u043E\u0434\u0438\u0442\u0435
        \u043D\u0430 \u0432\u044B\u043B\u0430\u0437\u043A\u0443: \u0432\u0441\u0451,
        \u0447\u0442\u043E \u043D\u0430\u0439\u0434\u0451\u0442\u0435, \u0441\u0430\u043C\u043E
        \u043B\u044F\u0436\u0435\u0442 \u0441\u044E\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
        \u0432\u0435\u0440\u043D\u0451\u0442\u0435\u0441\u044C \u0432 \u043B\u0430\u0432\u043A\u0443."
      kind: 0
      padding: 2
    - key: storage-sort
      text: "\u042D\u0442\u0430 \u043A\u043D\u043E\u043F\u043A\u0430 \u043C\u0435\u043D\u044F\u0435\u0442
        \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u043F\u043E \u043A\u0440\u0443\u0433\u0443:
        \u043F\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0443,
        \u0438\u043C\u0435\u043D\u0438, \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438,
        \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u0438, \u0446\u0435\u043D\u0435."
      kind: 0
      padding: 2
    - key: storage-close
      text: "\u0417\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043A\u0440\u0435\u0441\u0442\u0438\u043A\u043E\u043C,
        \u043A\u0430\u043A \u0432\u0441\u0451 \u0443 \u043D\u0430\u0441. \u041F\u0443\u0441\u0442\u044C
        \u0442\u043E\u0432\u0430\u0440 \u043D\u0435 \u0437\u0430\u043B\u0451\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F!"
      kind: 0
      padding: 2
  cardGap: 24
  travelSeconds: 0.6
  dragSeconds: 0.9
