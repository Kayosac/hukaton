    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430, \u0438 \u0440\u0430\u0431\u043E\u0442\u0430
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430 \u0431\u044B\u043B\u0430
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u0432\u043E
    \u0438\u0437\u0431\u0435\u0436\u0430\u043D\u0438\u0435 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F
    \u043B\u0430\u0432\u043A\u0438.\n\n\u0420\u0415\u041A\u041B\u0410\u041C\u0410_\u041D\u0415_\u0417\u0410\u041A\u0420\u042B\u0422\u0410_\u0412\u041E\u0412\u0420\u0415\u041C\u042F\n\n\u0415\u0441\u043B\u0438
    \u0432\u044B \u0432\u0438\u0434\u0438\u0442\u0435 \u044D\u0442\u043E\u0442 \u044D\u043A\u0440\u0430\u043D
    \u0432\u043F\u0435\u0440\u0432\u044B\u0435, \u043F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440. \u0415\u0441\u043B\u0438
    \u043E\u043D \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0441\u043D\u043E\u0432\u0430,
    \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0439\u0442\u0435 \u043E\u043A\u043D\u0430
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u041D\u0435 \u043D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435
    \u043D\u0430 \xAB\u0412\u044B \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0438!\xBB.
    \u041D\u0438\u043A\u043E\u0433\u0434\u0430.\n\n\u0412\u0438\u0440\u0443\u0441
    \xAB\u0421\u043A\u0438\u0434\u043A\u0430\u0413\u043E\u0431\u043B\u0438\u043D.exe\xBB
    \u0441\u043F\u0438\u0441\u0430\u043B \u0441\u043E \u0441\u0447\u0451\u0442\u0430
    \u043b\u0430\u0432\u043a\u0438 {penalty|\u043c\u043e\u043d\u0435\u0442\u0443|\u043c\u043e\u043d\u0435\u0442\u044b|\u043c\u043e\u043d\u0435\u0442}.\n\n\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F:\n*** STOP: 0x0000PENUS
    (0x0000000C, 0xDEADBEEF, 0x00000404)\n\n\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435
    \u0434\u0430\u043C\u043F\u0430 \u043F\u0430\u043C\u044F\u0442\u0438... 100%"
