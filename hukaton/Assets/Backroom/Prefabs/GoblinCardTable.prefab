--- !u!114 &6475492293910636413
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3364243619362874928}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b5574a8ddc4194dba8bf2770c3fafd1b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Hakaton.Backroom::Hakaton.Backroom.GoblinCardShop
  audioSource: {fileID: 4277146336091847437}
  dealSound: {fileID: 8300000, guid: 955b4f817083e4bc2bd6bab9235ac7e9, type: 3}
  flipSound: {fileID: 8300000, guid: eb1d01484d08e4c8c8e0bc6c80dabd56, type: 3}
  buySound: {fileID: 8300000, guid: 73fbb01d3994044bd9bfb2fd675bdd70, type: 3}
  refuseSound: {fileID: 8300000, guid: f6f3cc18cc46f4e9a8d26cbbd6692f92, type: 3}
  revealSound: {fileID: 8300000, guid: b0d5a8d118e3c4b1981e196589dbfeb5, type: 3}
  lineSound: {fileID: 8300000, guid: 39de7eed262b04327a79a6f68e9c4349, type: 3}
  visibility: {fileID: 3198473631376738071}
  cards:
  - {fileID: 5252465508239051078}
  - {fileID: 7499804832520945859}
  - {fileID: 1992163733829837928}
  - {fileID: 7611138313740854160}
  - {fileID: 6898059136946311071}
  - {fileID: 5513722995432691788}
  - {fileID: 6137571235136913555}
  - {fileID: 1354263009009577249}
  - {fileID: 8574352442034831831}
  - {fileID: 7463740793087530732}
  revealButton: {fileID: 5708217021173758297}
  leaveButton: {fileID: 7769253954845312762}
  revealLabel: {fileID: 380251607079051316}
  collection: {fileID: 7588629337435672138}
  bubble: {fileID: 8723656325936534849}
  bubbleGroup: {fileID: 7160620480005027204}
  continueHint: {fileID: 5351599344089964039}
  introduction:
  - "\u041E, \u043F\u0430\u0440\u0442\u043D\u0451\u0440! \u0427\u0435\u0433\u043E
    \u0443\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F? \u0412 \u043A\u0443\u0441\u0442\u0430\u0445
    \u044F \u0431\u044B\u043B \u0431\u0435\u0437 \u0440\u0430\u0431\u043E\u0447\u0435\u0439
    \u0444\u043E\u0440\u043C\u044B."
  - "\u0411\u0435\u0440\u0451\u0448\u044C \u0432\u0441\u043B\u0435\u043F\u0443\u044E
    \u2014 \u043F\u043E\u043B\u0446\u0435\u043D\u044B. \u041A\u0430\u0440\u0442\u0443
    \u0438 \u0446\u0435\u043D\u0443 \u0434\u043E \u043F\u043E\u043A\u0443\u043F\u043A\u0438
    \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E. \u0421\u044E\u0440\u043F\u0440\u0438\u0437
    \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u043F\u043E\u043B\u043D\u044B\u043C!"
  - "\u0425\u043E\u0447\u0435\u0448\u044C \u0432\u0441\u0451 \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C?
    \u041E\u0442\u043A\u0440\u043E\u044E \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
    \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E. \u041D\u043E \u0442\u043E\u0433\u0434\u0430
    \u043A\u0430\u0436\u0434\u0430\u044F \u2014 \u0437\u0430 \u043F\u043E\u043B\u043D\u0443\u044E
    \u0446\u0435\u043D\u0443. \u041B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E
    \u0443 \u043D\u0430\u0441 \u0434\u043E\u0440\u043E\u0433\u043E\u0435."
  - "\u041C\u043E\u0436\u0435\u0448\u044C \u0431\u0440\u0430\u0442\u044C \u0445\u043E\u0442\u044C
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E. \u041C\u043E\u0436\u0435\u0448\u044C
    \u043D\u0438\u0447\u0435\u0433\u043E. \u041D\u043E \u043F\u0435\u0440\u0432\u044B\u0439
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
    \u0431\u043E\u043B\u044C\u0448\u0435."
  boughtLines:
  - "\u0421\u044E\u0440\u043F\u0440\u0438\u0437!"
  - "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0432\u044B\u0431\u043E\u0440. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435."
  - "\u0411\u0435\u0440\u0438, \u043F\u043E\u043A\u0430 \u0442\u0451\u043F\u043B\u0430\u044F."
  - "\u041D\u0438 \u043A\u0430\u043F\u043B\u0438 \u043D\u0435 \u0436\u0430\u043B\u0435\u044E."
  poorLines:
  - "\u041C\u043E\u043D\u0435\u0442 \u043C\u0430\u043B\u043E\u0432\u0430\u0442\u043E,
    \u043F\u0430\u0440\u0442\u043D\u0451\u0440."
  - "\u0412 \u0434\u043E\u043B\u0433 \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044E.
    \u041F\u043E\u043A\u0430."
  fullLine: "\u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F \u0442\u0440\u0435\u0449\u0438\u0442
    \u043F\u043E \u0448\u0432\u0430\u043C. \u0421\u043E\u0436\u0433\u0438 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0432 \u0436\u0430\u0440\u043E\u0432\u043D\u0435."
  revealLine: "\u041B\u044E\u0431\u0443\u0439\u0441\u044F. \u0422\u0435\u043F\u0435\u0440\u044C
    \u043A\u0430\u0436\u0434\u0430\u044F \u043F\u043E \u043F\u043E\u043B\u043D\u043E\u0439."
  emptyLine: "\u0412\u0441\u0451 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0438.
    \u041F\u0440\u0438\u0445\u043E\u0434\u0438 \u043F\u043E\u0441\u043B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B."
