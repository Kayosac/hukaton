  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01636bd09e1f74fa5abe679e0a018a22, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Hakaton.GodMountains::Hakaton.GodMountains.GodEncounter
  god: {fileID: 806209542}
  head: {fileID: 806209541}
  finger: {fileID: 806209540}
  fingerColliders:
  - {fileID: 1288105428}
  - {fileID: 1952874643}
  - {fileID: 806209543}
  mouth: {fileID: 368129748}
  edgeLine: {fileID: 706762789}
  lip: {fileID: 583251383}
  checkpoint: {fileID: 436769225}
  edgeWall: {fileID: 404410195}
  motor: {fileID: 54777192}
  view: {fileID: 54777190}
  control: {fileID: 54777193}
  bubble: {fileID: 713992250}
  noticeRadius: 7
  edgeHalfWidth: 4
  boardSeconds: 0.5
  boardBeyondLip: 2
  fallDepth: 8
  faceHeight: 0.55
  fingerTopHeight: 20
  followRate: 1.6
  lines:
  - "\u0410. \u0412\u043E\u0442 \u0442\u044B \u0433\u0434\u0435. \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439.
    \u0428\u0443\u043C\u043D\u044B\u0439."
  - "\u0422\u044B \u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437 \u043C\u043E\u044E
    \u0433\u043E\u0440\u0443. \u041A\u0430\u0436\u0434\u044B\u0439 \u0442\u0432\u043E\u0439
    \u0448\u0430\u0433 \u0449\u0435\u043A\u043E\u0442\u0430\u043B \u043C\u043D\u0435
    \u043B\u0430\u0434\u043E\u043D\u044C."
  - "\u0412\u043D\u0438\u0437\u0443 \u0442\u044B \u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C.
    \u041C\u043E\u043D\u0435\u0442\u044B \u0437\u0432\u0435\u043D\u044F\u0442 \u0434\u043E
    \u0441\u0430\u043C\u044B\u0445 \u043E\u0431\u043B\u0430\u043A\u043E\u0432, \u044F
    \u0441\u043B\u044B\u0448\u0443."
  - "\u0422\u044B\u0441\u044F\u0447\u0430 \u043C\u043E\u043D\u0435\u0442. \u0414\u043B\u044F
    \u0442\u0435\u0431\u044F \u0433\u043E\u0440\u0430. \u0414\u043B\u044F \u043C\u0435\u043D\u044F
    \u043F\u044B\u043B\u0438\u043D\u043A\u0430 \u043D\u0430 \u043D\u043E\u0433\u0442\u0435."
  - "\u041D\u043E \u0442\u044B \u0434\u043E\u0448\u0451\u043B. \u0417\u043D\u0430\u0447\u0438\u0442,
    \u0442\u0432\u043E\u044F \u0434\u0432\u0435\u0440\u044C \u0442\u0435\u043F\u0435\u0440\u044C
    \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u0438 \u0432 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043C\u0435\u0441\u0442\u0430."
  - "\u0418\u0434\u0438. \u0422\u043E\u0440\u0433\u0443\u0439. \u0411\u0440\u043E\u0441\u0430\u0439
    \u0441\u0432\u043E\u0438 \u043A\u0430\u0440\u0442\u044B \u0432 \u043A\u0430\u043C\u043D\u0438
    \u043C\u0438\u0440\u0430."
  finished:
    m_PersistentCalls:
      m_Calls: []
